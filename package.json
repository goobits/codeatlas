{
	"name": "@goobits/codeatlas",
	"license": "SEE LICENSE IN LICENSE",
	"version": "0.10.0",
	"description": "Map source code and compile declared architecture across languages",
	"type": "commonjs",
	"packageManager": "pnpm@10.25.0",
	"scripts": {
		"check": "pnpm run test && pnpm run probe:check && pnpm run spec:check && cargo fmt --check && cargo clippy --all-targets --jobs 1 -- -D warnings && pnpm run self:check && pnpm run pack:check",
		"test": "pnpm run test:node && cargo test --locked --jobs 1",
		"test:interop:hqa": "cargo test --locked --jobs 1 outputs::hqa_inventory::tests::golden_inventory_validates_against_external_hqa_schema -- --ignored --exact",
		"test:interop:resolution": "cargo test --locked --jobs 1 --bin codeatlas tests::interop::agentspeak_resolution_conformance_matches_source_graph -- --exact --nocapture",
		"test:postgres-live": "cargo test --locked --jobs 1 --test postgres_cli managed_postgres_smoke_covers_replay_baseline_diff_and_cleanup -- --ignored --exact --nocapture",
		"test:node": "node --test tests/wrapper.test.js tests/storage.test.js tests/build-topology.test.js tests/container-image-build.test.js tests/isolation-live.test.js",
		"test:isolation-live": "node tasks/check-isolation-live.js",
		"probe:build": "node tasks/build-isolation-probe.js",
		"http-workload:build": "node tasks/build-http-workload.js",
		"probe:check": "cargo fmt --manifest-path crates/isolation-conformance/Cargo.toml --check && cargo test --manifest-path crates/isolation-conformance/Cargo.toml --locked --jobs 1 && cargo clippy --manifest-path crates/isolation-conformance/Cargo.toml --all-targets -- -D warnings",
		"spec:check": "node tasks/check-architecture-spec.js",
		"spec:write": "node tasks/check-architecture-spec.js --write",
		"schemas:write": "node tasks/update-schemas.js",
		"self:check": "node tasks/check-self.js",
		"pack:check": "node tasks/check-package.js",
		"release": "node tasks/release.js patch",
		"release:minor": "node tasks/release.js minor",
		"release:major": "node tasks/release.js major"
	},
	"bin": {
		"codeatlas": "bin/codeatlas.js"
	},
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/goobits/codeatlas.git"
	},
	"bugs": "https://github.com/goobits/codeatlas/issues",
	"homepage": "https://github.com/goobits/codeatlas#readme",
	"files": [
		"bin/**",
		"src/**",
		"crates/domain/**",
		"crates/source/**",
		"crates/isolation-conformance/Cargo.lock",
		"crates/isolation-conformance/Cargo.toml",
		"crates/isolation-conformance/src/**",
		"schemas/**",
		"spec/architecture/v0.1/**",
		"Cargo.toml",
		"Cargo.lock",
		"LICENSE",
		"README.md"
	],
	"dependencies": {
		"squawk-cli": "2.61.0",
		"tar": "^7.5.21"
	}
}
