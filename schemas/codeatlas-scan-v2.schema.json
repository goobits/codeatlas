{
  "$defs": {
    "FileEdge": {
      "description": "A dependency edge from one file to another.",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "ImportUsage": {
      "properties": {
        "id": {
          "type": "string"
        },
        "importers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "importers"
      ],
      "type": "object"
    },
    "Language": {
      "enum": [
        "TypeScript",
        "Python",
        "Rust",
        "Unknown"
      ],
      "type": "string"
    },
    "PackageExport": {
      "properties": {
        "public_path": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        }
      },
      "required": [
        "public_path",
        "source_path"
      ],
      "type": "object"
    },
    "PackageInfo": {
      "properties": {
        "exports": {
          "items": {
            "$ref": "#/$defs/PackageExport"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ScanStats": {
      "properties": {
        "files_scanned": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "files_skipped": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "symbols_found": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "files_scanned",
        "files_skipped",
        "symbols_found"
      ],
      "type": "object"
    },
    "SkippedFile": {
      "properties": {
        "language": {
          "$ref": "#/$defs/Language"
        },
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason",
        "language"
      ],
      "type": "object"
    },
    "Span": {
      "properties": {
        "end_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_col",
        "end_line",
        "end_col"
      ],
      "type": "object"
    },
    "Stability": {
      "enum": [
        "experimental",
        "beta",
        "stable"
      ],
      "type": "string"
    },
    "Symbol": {
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/Symbol"
          },
          "type": "array"
        },
        "docs": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolDocs"
            },
            {
              "type": "null"
            }
          ]
        },
        "export_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "file_path": {
          "type": "string"
        },
        "id": {
          "description": "ID Format: \"{lang}:{repo_path}:{kind}#{name}\"",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SymbolKind"
        },
        "language": {
          "$ref": "#/$defs/Language"
        },
        "name": {
          "type": "string"
        },
        "package": {
          "type": [
            "string",
            "null"
          ]
        },
        "referenced": {
          "description": "True when the symbol is required to understand an exported signature but is not directly importable.",
          "type": "boolean"
        },
        "signature": {
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "visibility",
        "language",
        "file_path",
        "signature",
        "children"
      ],
      "type": "object"
    },
    "SymbolDocs": {
      "properties": {
        "deprecated": {
          "type": [
            "string",
            "null"
          ]
        },
        "examples": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "internal": {
          "type": "boolean"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "remarks": {
          "type": [
            "string",
            "null"
          ]
        },
        "returns": {
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "stability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stability"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "throws": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SymbolKind": {
      "enum": [
        "Module",
        "Class",
        "Method",
        "Function",
        "Interface",
        "Struct",
        "Const",
        "Property",
        "Decorator",
        "Enum",
        "Trait",
        "TypeAlias"
      ],
      "type": "string"
    },
    "UnusedPublic": {
      "properties": {
        "id": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "suggestion"
      ],
      "type": "object"
    },
    "Visibility": {
      "enum": [
        "Public",
        "Internal",
        "Private",
        "Unknown"
      ],
      "type": "string"
    }
  },
  "$id": "codeatlas.scan/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "file_edges": {
      "default": [],
      "description": "Direct file-to-file dependency edges (for visualization)",
      "items": {
        "$ref": "#/$defs/FileEdge"
      },
      "type": "array"
    },
    "imports": {
      "items": {
        "$ref": "#/$defs/ImportUsage"
      },
      "type": "array"
    },
    "package": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 2,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "skipped_files": {
      "items": {
        "$ref": "#/$defs/SkippedFile"
      },
      "type": "array"
    },
    "stats": {
      "$ref": "#/$defs/ScanStats"
    },
    "symbols": {
      "items": {
        "$ref": "#/$defs/Symbol"
      },
      "type": "array"
    },
    "tool_version": {
      "type": "string"
    },
    "unused_public": {
      "items": {
        "$ref": "#/$defs/UnusedPublic"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "tool_version",
    "stats",
    "symbols",
    "skipped_files",
    "imports",
    "unused_public"
  ],
  "title": "ScanReport",
  "type": "object"
}
