{
  "$defs": {
    "PostgresBaselineBootstrap": {
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256"
      ],
      "type": "object"
    },
    "PostgresBaselineLintFinding": {
      "properties": {
        "artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "type": "string"
        },
        "contractId": {
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/PostgresEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "contractId"
      ],
      "type": "object"
    },
    "PostgresBaselineMigration": {
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256"
      ],
      "type": "object"
    },
    "PostgresBaselineQuery": {
      "properties": {
        "dynamic": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PostgresQueryKind"
        },
        "parameterCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256",
        "parameterCount",
        "dynamic",
        "kind"
      ],
      "type": "object"
    },
    "PostgresCatalogColumn": {
      "properties": {
        "dataType": {
          "type": "string"
        },
        "defaultDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        },
        "position": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "type": "string"
        },
        "table": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "table",
        "name",
        "position",
        "dataType",
        "nullable"
      ],
      "type": "object"
    },
    "PostgresCatalogConstraint": {
      "properties": {
        "definitionDigest": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "table": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "table",
        "name",
        "kind",
        "definitionDigest"
      ],
      "type": "object"
    },
    "PostgresCatalogIndex": {
      "properties": {
        "definitionDigest": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "unique": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "schema",
        "table",
        "name",
        "unique",
        "valid",
        "definitionDigest"
      ],
      "type": "object"
    },
    "PostgresCatalogInventory": {
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/PostgresCatalogColumn"
          },
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/PostgresCatalogConstraint"
          },
          "type": "array"
        },
        "digest": {
          "type": "string"
        },
        "indexes": {
          "items": {
            "$ref": "#/$defs/PostgresCatalogIndex"
          },
          "type": "array"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/PostgresCatalogTable"
          },
          "type": "array"
        }
      },
      "required": [
        "digest",
        "tables",
        "columns",
        "constraints",
        "indexes"
      ],
      "type": "object"
    },
    "PostgresCatalogTable": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "name",
        "kind"
      ],
      "type": "object"
    },
    "PostgresEvidence": {
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "type": "object"
    },
    "PostgresQueryKind": {
      "enum": [
        "select",
        "insert",
        "update",
        "delete",
        "with",
        "other"
      ],
      "type": "string"
    }
  },
  "$id": "codeatlas.postgres-baseline/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "apiVersion": {
      "const": "codeatlas.postgres-baseline/v1",
      "type": "string"
    },
    "bootstraps": {
      "items": {
        "$ref": "#/$defs/PostgresBaselineBootstrap"
      },
      "type": "array"
    },
    "catalog": {
      "$ref": "#/$defs/PostgresCatalogInventory"
    },
    "contractId": {
      "type": "string"
    },
    "lintFindings": {
      "items": {
        "$ref": "#/$defs/PostgresBaselineLintFinding"
      },
      "type": "array"
    },
    "migrations": {
      "items": {
        "$ref": "#/$defs/PostgresBaselineMigration"
      },
      "type": "array"
    },
    "queries": {
      "items": {
        "$ref": "#/$defs/PostgresBaselineQuery"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "serverMajor": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "apiVersion",
    "contractId",
    "serverMajor",
    "bootstraps",
    "migrations",
    "queries",
    "lintFindings",
    "catalog"
  ],
  "title": "PostgresBaselineReport",
  "type": "object"
}
