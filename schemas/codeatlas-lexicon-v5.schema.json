          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "configured_morphology": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "source_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version",
        "builtin_abbreviations",
        "configured_abbreviations",
        "builtin_morphology",
        "configured_morphology",
        "candidate_strategy"
