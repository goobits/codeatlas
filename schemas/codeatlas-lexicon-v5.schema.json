        "mode": {
          "$ref": "#/$defs/ConceptualAnalysisMode"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/LexiconSource"
          },
          "type": "array"
        },
        "suppressed_candidates": {
          "items": {
            "$ref": "#/$defs/SuppressedConceptCandidate"
