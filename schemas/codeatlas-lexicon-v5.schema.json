        "license": {
          "type": "string"
        },
        "records_read": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "relations_indexed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "relations_loaded": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
