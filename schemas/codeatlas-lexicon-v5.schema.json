        "source_id": {
          "type": "string"
        },
        "source_version": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/ConceptEvidenceTier"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "tier",
        "relation",
        "subject",
        "object"
      ],
      "type": "object"
    },
