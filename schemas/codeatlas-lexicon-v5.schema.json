            "$ref": "#/$defs/ConceptEvidence"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "preferred_terms": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/ConceptCandidateRule"
        },
        "suggested_suppression": {
          "anyOf": [
            {
              "$ref": "#/$defs/SuggestedSuppression"
            },
            {
              "type": "null"
            }
          ]
        },
        "terms": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/ConceptCandidateTier"
        },
        "usages": {
          "items": {
            "$ref": "#/$defs/ConceptTermUsage"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "terms",
        "concept_ids",
        "rule",
        "reason",
        "tier",
        "confidence",
        "preferred_terms",
        "evidence",
        "usages"
