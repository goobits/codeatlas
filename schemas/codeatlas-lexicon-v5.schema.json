      "type": "string"
    },
    "LexiconProviderCoverage": {
      "enum": [
        "complete",
        "filtered"
      ],
      "type": "string"
    },
    "LexiconProviderFormat": {
      "enum": [
        "cso_csv",
        "relations_json_v1"
