    "ConceptSuppressionKind": {
      "enum": [
        "distinct_from",
        "never_suggest"
      ],
      "type": "string"
    },
    "ConceptTermUsage": {
      "properties": {
        "symbols": {
          "items": {
            "$ref": "#/$defs/LexiconSymbol"
          },
          "type": "array"
        },
        "term": {
          "type": "string"
        }
      },
      "required": [
        "term",
        "symbols"
      ],
      "type": "object"
    },
    "ConceptualAnalysis": {
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/ConceptCandidate"
          },
          "type": "array"
        },
        "identifier_grammar": {
          "$ref": "#/$defs/IdentifierGrammarSummary"
