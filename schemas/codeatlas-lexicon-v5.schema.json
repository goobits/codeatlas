        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason",
        "concept_ids"
      ],
      "type": "object"
    },
    "CallableCandidate": {
      "properties": {
        "callable_shape": {
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "kind": {
          "$ref": "#/$defs/CallableCandidateKind"
        },
        "names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "shared_terms": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "symbols": {
          "items": {
            "$ref": "#/$defs/LexiconSymbol"
          },
          "type": "array"
        }
