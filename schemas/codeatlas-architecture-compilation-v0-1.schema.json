{
  "$defs": {
    "ArchitectureLockfile": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "atlas.codeatlas.dev/v0.1",
          "type": "string"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/LockDocument"
          },
          "type": "array"
        },
        "generated": {
          "type": "boolean"
        },
        "generator": {
          "$ref": "#/$defs/GeneratorIdentity"
        },
        "manualEditing": {
          "type": "string"
        },
        "roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schemaVersion": {
          "const": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "vocabulary": {
          "$ref": "#/$defs/VocabularyIdentity"
        }
      },
      "required": [
        "schemaVersion",
        "apiVersion",
        "generated",
        "manualEditing",
        "generator",
        "roots",
        "vocabulary",
        "documents"
      ],
      "type": "object"
    },
    "CompilationReport": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "atlas.codeatlas.dev/v0.1",
          "type": "string"
        },
        "architectureClosureDigest": {
          "type": "string"
        },
        "compilerVersion": {
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/CompiledGraph"
        },
        "graphDigest": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/CompileMode"
        },
        "roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schemaVersion": {
          "const": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "toolVersion": {
          "type": "string"
        },
        "vocabulary": {
          "$ref": "#/$defs/VocabularyIdentity"
        }
      },
      "required": [
        "schemaVersion",
        "apiVersion",
        "toolVersion",
        "compilerVersion",
        "mode",
        "architectureClosureDigest",
        "graphDigest",
        "vocabulary",
        "roots",
        "graph"
      ],
      "type": "object"
    },
    "CompileMode": {
      "enum": [
        "governing",
        "review"
      ],
      "type": "string"
    },
    "CompiledGraph": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/GraphDeclaration"
          },
          "type": "object"
        },
        "constraints": {
          "additionalProperties": {
            "$ref": "#/$defs/GraphDeclaration"
          },
          "type": "object"
        },
        "mode": {
          "$ref": "#/$defs/CompileMode"
        },
        "objects": {
          "additionalProperties": {
            "$ref": "#/$defs/GraphDeclaration"
          },
          "type": "object"
        },
        "relations": {
          "additionalProperties": {
            "$ref": "#/$defs/GraphDeclaration"
          },
          "type": "object"
        }
      },
      "required": [
        "mode",
        "objects",
        "relations",
        "bindings",
        "constraints"
      ],
      "type": "object"
    },
    "GeneratorIdentity": {
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "GraphDeclaration": {
      "additionalProperties": false,
      "properties": {
        "declaration": true,
        "module": {
          "type": "string"
        }
      },
      "required": [
        "module",
        "declaration"
      ],
      "type": "object"
    },
    "LockDocument": {
      "additionalProperties": false,
      "properties": {
        "architectureVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "canonicalModuleDigest": {
          "type": "string"
        },
        "importClosureDigest": {
          "type": "string"
        },
        "moduleId": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sourceDocumentDigest": {
          "type": "string"
        }
      },
      "required": [
        "moduleId",
        "architectureVersion",
        "source",
        "sourceDocumentDigest",
        "canonicalModuleDigest",
        "importClosureDigest"
      ],
      "type": "object"
    },
    "VocabularyIdentity": {
      "properties": {
        "digest": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    }
  },
  "$id": "atlas.codeatlas.dev/architecture-compilation/v0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lockfile": {
      "$ref": "#/$defs/ArchitectureLockfile"
    },
    "report": {
      "$ref": "#/$defs/CompilationReport"
    }
  },
  "required": [
    "report",
    "lockfile"
  ],
  "title": "CompileResult",
  "type": "object"
}
