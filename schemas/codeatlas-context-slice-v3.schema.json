{
  "$defs": {
    "AnalysisBoundary": {
      "properties": {
        "effect": {
          "$ref": "#/$defs/AnalysisCompleteness"
        },
        "evidence": {
          "$ref": "#/$defs/SourceEvidence"
        },
        "kind": {
          "$ref": "#/$defs/BoundaryKind"
        },
        "message": {
          "type": "string"
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "kind",
        "effect",
        "message",
        "evidence"
      ],
      "type": "object"
    },
    "AnalysisCompleteness": {
      "enum": [
        "complete",
        "partial",
        "unsupported"
      ],
      "type": "string"
    },
    "BoundaryKind": {
      "enum": [
        "dynamic_import",
        "reflection",
        "macro_expansion",
        "conditional_compilation",
        "unresolved_internal",
        "unsupported_dependency",
        "unsupported_syntax"
      ],
      "type": "string"
    },
    "ContextDirection": {
      "enum": [
        "incoming",
        "outgoing",
        "both"
      ],
      "type": "string"
    },
    "ContextRole": {
      "enum": [
        "production",
        "test",
        "tooling"
      ],
      "type": "string"
    },
    "ContextScope": {
      "enum": [
        "runtime",
        "public_surface"
      ],
      "type": "string"
    },
    "ContextSliceOmitted": {
      "properties": {
        "boundaries": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "contexts": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "edges": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "nodes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "projects": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "projects",
        "nodes",
        "edges",
        "contexts",
        "boundaries"
      ],
      "type": "object"
    },
    "EdgeTarget": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "node",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "external",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "unexported_workspace",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "unresolved_internal",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "dynamic_unknown",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "unsupported",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "SourceBinding": {
      "properties": {
        "exported": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported": {
          "type": "string"
        },
        "local": {
          "type": "string"
        },
        "namespace": {
          "default": false,
          "type": "boolean"
        },
        "type_only": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "imported",
        "local"
      ],
      "type": "object"
    },
    "SourceContext": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ContextRole"
        },
        "roots": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "$ref": "#/$defs/ContextScope",
          "default": "runtime"
        }
      },
      "required": [
        "id",
        "project",
        "name",
        "role",
        "roots"
      ],
      "type": "object"
    },
    "SourceEdge": {
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/SourceBinding"
          },
          "type": "array"
        },
        "evidence": {
          "$ref": "#/$defs/SourceEvidence"
        },
        "from": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceEdgeKind"
        },
        "to": {
          "$ref": "#/$defs/EdgeTarget"
        }
      },
      "required": [
        "from",
        "to",
        "kind",
        "evidence"
      ],
      "type": "object"
    },
    "SourceEdgeKind": {
      "enum": [
        "contains",
        "module_dependency",
        "import",
        "re_export",
        "dynamic_import",
        "glob_import",
        "require",
        "workspace_source_bypass",
        "lexical_reference",
        "assume_reachable"
      ],
      "type": "string"
    },
    "SourceEvidence": {
      "properties": {
        "extractor": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "extractor"
      ],
      "type": "object"
    },
    "SourceFile": {
      "properties": {
        "language": {
          "$ref": "#/$defs/SourceLanguage"
        },
        "path": {
          "type": "string"
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "path",
        "language"
      ],
      "type": "object"
    },
    "SourceLanguage": {
      "enum": [
        "javascript",
        "typescript",
        "svelte",
        "python",
        "rust"
      ],
      "type": "string"
    },
    "SourceNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/SourceFile",
          "properties": {
            "kind": {
              "const": "file",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/SourceSymbol",
          "properties": {
            "kind": {
              "const": "symbol",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "SourceProject": {
      "properties": {
        "completeness": {
          "$ref": "#/$defs/AnalysisCompleteness"
        },
        "id": {
          "type": "string"
        },
        "languages": {
          "items": {
            "$ref": "#/$defs/SourceLanguage"
          },
          "type": "array",
          "uniqueItems": true
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "root",
        "languages",
        "completeness"
      ],
      "type": "object"
    },
    "SourceSymbol": {
      "properties": {
        "file": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "symbol_kind": {
          "$ref": "#/$defs/SourceSymbolKind"
        },
        "visibility": {
          "$ref": "#/$defs/SourceVisibility"
        }
      },
      "required": [
        "project",
        "file",
        "name",
        "symbol_kind",
        "visibility"
      ],
      "type": "object"
    },
    "SourceSymbolKind": {
      "enum": [
        "module",
        "class",
        "function",
        "method",
        "variable",
        "constant",
        "interface",
        "struct",
        "enum",
        "trait",
        "type_alias",
        "property",
        "other"
      ],
      "type": "string"
    },
    "SourceVisibility": {
      "enum": [
        "public",
        "internal",
        "private",
        "unknown"
      ],
      "type": "string"
    },
    "Span": {
      "properties": {
        "end_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_col",
        "end_line",
        "end_col"
      ],
      "type": "object"
    },
    "TargetResolution": {
      "properties": {
        "nodes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query",
        "nodes"
      ],
      "type": "object"
    }
  },
  "$id": "codeatlas.context-slice/v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "boundaries": {
      "items": {
        "$ref": "#/$defs/AnalysisBoundary"
      },
      "type": "array"
    },
    "contexts": {
      "items": {
        "$ref": "#/$defs/SourceContext"
      },
      "type": "array"
    },
    "continuation": {
      "type": [
        "string",
        "null"
      ]
    },
    "depth": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "direction": {
      "$ref": "#/$defs/ContextDirection"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/SourceEdge"
      },
      "type": "array"
    },
    "graph_digest": {
      "type": "string"
    },
    "max_nodes": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "nodes": {
      "additionalProperties": {
        "$ref": "#/$defs/SourceNode"
      },
      "type": "object"
    },
    "omitted": {
      "$ref": "#/$defs/ContextSliceOmitted"
    },
    "page_offset": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/SourceProject"
      },
      "type": "array"
    },
    "remaining_nodes": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": 3,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/TargetResolution"
      },
      "type": "array"
    },
    "tool_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "tool_version",
    "depth",
    "max_nodes",
    "direction",
    "graph_digest",
    "page_offset",
    "remaining_nodes",
    "omitted",
    "targets",
    "projects",
    "nodes",
    "edges",
    "contexts",
    "boundaries"
  ],
  "title": "ContextSliceReport",
  "type": "object"
}
