{
  "$defs": {
    "ConformanceEvidence": {
      "properties": {
        "coverageIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "factIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "factIds",
        "coverageIds"
      ],
      "type": "object"
    },
    "ConformanceInputs": {
      "properties": {
        "architectureClosureDigest": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        },
        "governingGraphDigest": {
          "type": "string"
        },
        "observationContentDigest": {
          "type": "string"
        },
        "policyClosureDigest": {
          "type": "string"
        },
        "validatorVersion": {
          "type": "string"
        },
        "vocabularyDigest": {
          "type": "string"
        }
      },
      "required": [
        "governingGraphDigest",
        "architectureClosureDigest",
        "policyClosureDigest",
        "observationContentDigest",
        "vocabularyDigest",
        "validatorVersion",
        "asOf"
      ],
      "type": "object"
    },
    "ConformanceResult": {
      "properties": {
        "declarationId": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/ConformanceEvidence"
        },
        "exceptions": {
          "$ref": "#/$defs/ExceptionDispositions"
        },
        "explanation": {
          "type": "string"
        },
        "reasonCode": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "state": {
          "$ref": "#/$defs/ConformanceState"
        }
      },
      "required": [
        "declarationId",
        "state",
        "severity",
        "reasonCode",
        "evidence",
        "exceptions",
        "explanation"
      ],
      "type": "object"
    },
    "ConformanceState": {
      "enum": [
        "matched",
        "partial",
        "absent",
        "conflicting",
        "unexpected",
        "unobserved",
        "ambiguous"
      ],
      "type": "string"
    },
    "ExceptionDispositions": {
      "properties": {
        "applied": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expired": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "irrelevant": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rejected": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stale": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "applied",
        "stale",
        "expired",
        "irrelevant",
        "rejected"
      ],
      "type": "object"
    },
    "GeneratedMetadata": {
      "properties": {
        "architectureVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "generated": {
          "type": "boolean"
        },
        "generatedAt": {
          "type": "string"
        },
        "generationCommand": {
          "type": "string"
        },
        "generator": {
          "$ref": "#/$defs/GeneratorIdentity"
        },
        "id": {
          "type": "string"
        },
        "manualEditing": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sourceInputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "architectureVersion",
        "generated",
        "generator",
        "generatedAt",
        "sourceInputs",
        "generationCommand",
        "manualEditing"
      ],
      "type": "object"
    },
    "GeneratorIdentity": {
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "advisory"
      ],
      "type": "string"
    },
    "VocabularyIdentity": {
      "properties": {
        "digest": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    }
  },
  "$id": "atlas.codeatlas.dev/architecture-conformance/v0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "apiVersion": {
      "const": "atlas.codeatlas.dev/v0.1",
      "type": "string"
    },
    "conformanceInputs": {
      "$ref": "#/$defs/ConformanceInputs"
    },
    "conformanceResultDigest": {
      "type": "string"
    },
    "kind": {
      "const": "ArchitectureConformance",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/GeneratedMetadata"
    },
    "results": {
      "additionalProperties": {
        "$ref": "#/$defs/ConformanceResult"
      },
      "type": "object"
    },
    "vocabulary": {
      "$ref": "#/$defs/VocabularyIdentity"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "vocabulary",
    "conformanceInputs",
    "results",
    "conformanceResultDigest"
  ],
  "title": "ArchitectureConformance",
  "type": "object"
}
