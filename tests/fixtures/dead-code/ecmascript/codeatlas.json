{
  "projects": [
    {
      "id": "ecmascript",
      "root": ".",
      "languages": ["js", "ts"],
      "contexts": {
        "application": {
          "role": "production",
          "entrypoints": ["src/index.ts"]
        },
        "unit-tests": {
          "role": "test",
          "entrypoints": ["tests/**/*.test.ts"]
        },
        "build-tools": {
          "role": "tooling",
          "entrypoints": ["scripts/**/*.ts"]
        }
      }
    }
  ]
}
